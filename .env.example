# Server Port
PORT=10000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret_string

# Frontend URL (Your Vercel deployment URL, e.g., https://your-aegisdisposal.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app

# Frontend API base URL (set as VITE_API_URL in Vercel; public URL, not a secret)
VITE_API_URL=https://your-backend.onrender.com

# Admin Credentials
ADMIN_EMAIL=admin@aegisdisposal.local
ADMIN_ID=USR-00
ADMIN_NAME=AegisDisposal Administrator
ADMIN_PASSWORD_HASH=replace_with_admin_bcrypt_hash

# Google OAuth 2.0 (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/auth/google/callback
