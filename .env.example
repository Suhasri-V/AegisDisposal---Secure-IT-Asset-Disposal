# ─────────────────────────────────────────────────────────────────────────────
# AegisDisposal SecOps — Environment Variable Reference
# Copy this file to .env and fill in real values. Never commit .env!
# ─────────────────────────────────────────────────────────────────────────────

# Server port (backend Express API)
PORT=5000

# Application environment: development | production
NODE_ENV=development

# JSON Web Token secret — use a long random string in production
JWT_SECRET=

# ─── URLS ──────────────────────────────────────────────────────────────────────
# The URL the Vite frontend dev-server is reachable on (browser-visible)
FRONTEND_URL=http://localhost:3000

# ─── AUTHORIZED ADMIN CONFIGURATION ───────────────────────────────────────────
# The single Admin email address for this installation
ADMIN_EMAIL=
# A short internal ID assigned to the Admin account (e.g. USR-00)
ADMIN_ID=USR-00
# Display name for the Admin account
ADMIN_NAME=Administrator
# bcrypt hash of the Admin password. Generate with: npm run admin:hash
ADMIN_PASSWORD_HASH=

# ─── GOOGLE OAUTH 2.0 ──────────────────────────────────────────────────────────
# How to obtain credentials:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Click "Create Credentials" → "OAuth 2.0 Client ID"
#   3. Application type: "Web application"
#   4. Authorized JavaScript origins:
#        http://localhost:3000           (local dev)
#   5. Authorized redirect URIs:
#        http://localhost:5000/api/auth/google/callback   (local dev)
#   6. Copy the Client ID and Client Secret below
#
# Leave blank to disable Google Sign-In — the rest of the app works normally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
