{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/api/auth/google",
      "destination": "https://accounts.google.com/o/oauth2/v2/auth?client_id=1008518815688-mkscml1pj4391nnk9hrhqkn5mrtfk3rt.apps.googleusercontent.com&redirect_uri=https%3A%2F%2Faegisdisposal-secure-it-asset-disposal.onrender.com%2Fapi%2Fauth%2Fgoogle%2Fcallback&response_type=code&scope=openid%20email%20profile&prompt=select_account",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aegisdisposal-secure-it-asset-disposal.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
